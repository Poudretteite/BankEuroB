# ============================================================
# BankEuroB – Zmienne środowiskowe
# ============================================================

# PostgreSQL
POSTGRES_DB=bankeurob
POSTGRES_USER=bankeurob_user
POSTGRES_PASSWORD=BankEuroB_Secret2026!
POSTGRES_PORT=5433

# pgAdmin (panel webowy do podglądu bazy)
PGADMIN_EMAIL=admin@bankeurob.eu
PGADMIN_PASSWORD=admin123

# Backend
BACKEND_PORT=8080
JWT_SECRET=BankEuroBJwtSuperSecretKey2026MustBe256BitsLong!!
JWT_EXPIRATION_MS=86400000

# Frontend
FRONTEND_PORT=3001

# ============================================================
# Systemy płatnicze – adresy URL (dla lokalnego developmentu)
# ============================================================

# TARGET RTGS (Centralny system rozliczeń międzybankowych)
INTEGRATION_TARGET_BASEURL=http://localhost:8001

# SEPA Batch (System rozliczeń batchowych)
INTEGRATION_SEPA_BATCH_BASEURL=http://localhost:8002

# SEPA Instant (System przelewów natychmiastowych)
INTEGRATION_SEPA_INSTANT_BASEURL=http://localhost:8003

# SWIFT Middleware (System rozliczeń SWIFT)
INTEGRATION_SWIFT_BASEURL=http://localhost:3000

# Payment Gateway (System kart płatniczych)
INTEGRATION_CARDS_GATEWAY_BASEURL=http://localhost:8072
